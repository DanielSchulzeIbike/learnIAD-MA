Sigma <- matrix(c(var_intercept, cov_intercept_slope,
cov_intercept_slope, var_slope),
nrow = 2, ncol = 2)
# Generate random effects for each person
random_effects <- mvrnorm(n = n_persons, mu = c(0, 0), Sigma = Sigma)
u0 <- random_effects[, 1]  # Random intercepts
u1 <- random_effects[, 2]  # Random slopes
# Generate response variable
DatL <- list()
for (i in 1:n_persons) {
Dat_person <- data.frame(
id = person[i],
time = 1:obs_person[i])
Dat_person$y <- (fixed_intercept + u0[i]) + (fixed_slope + u1[i]) * Dat_person$time +
rnorm(obs_person[i], mean = 0, sd = sqrt(residual_var))
DatL[[i]] <- Dat_person
}
Dat <- do.call(rbind, DatL)
mod <- lmer(y ~ 1 + time + (1 + time|id),
data = Dat)
print(r.squaredGLMM(mod))
icc(mod)
}
