NRange <- c(5, 50) # sensible range of Ns (min, max)
replications <- 100 # replications per N (-> speed v accuracy)
power <- 0.80 # to accomodate CI width planning
for (i in 1:100) { # outer loop: steering the Ns put into power analyses below
if (i == 1) { # for first sequence on Ns
last <- FALSE
Ntest <- seq(NRange[1], NRange[2], round((NRange[2] - NRange[1]) / 5))
res <- data.frame(matrix(0,
replications*length(Ntest),
2))
colnames(res) <- c("N", "p")
} else { # for further sequences of Ns
optim <- which((resTab$power > power) == TRUE)[1]
NRange <- c(Ntest[optim - 1], Ntest[optim + 1])
if (last) {
print(paste0("Optimal N: ", Ntest[optim]))
break}
if (Ntest[optim] - Ntest[optim - 1] <= 5) {
Ntest <- seq(NRange[1], NRange[2], 1)
last <- TRUE
} else {
Ntest <- seq(NRange[1], NRange[2], round((NRange[2] - NRange[1]) / 5))
}
res <- data.frame(matrix(0,
replications*length(Ntest),
2))
colnames(res) <- c("N", "p")
}
for (N in Ntest) { # inner loop: power analysis itself.
print(N)
for (rep in 1:replications) {
Dat <- simulate_lmm(n_subjects = N,
n_time = 35,
R2_marginal = 0.31)
mod <- suppressWarnings(lmer(y ~ 1 + time + (1 + time|id),
data = Dat))
p <- summary(mod)$coefficients[2, 5]
res[rep + replications*(which(Ntest %in% N) - 1), 1] <- N
res[rep + replications*(which(Ntest %in% N) - 1), 2] <- p
}
}
res$test <- res$p < .05
resTab <- aggregate(res$test, by = list(res$N), FUN = sum) # calculating achieved power per N
colnames(resTab) <- c("N", "power")
resTab$power <- resTab$power / replications
print(resTab)
if (resTab$power[1] >= power) stop("Optimal N below range")
if (resTab$power[nrow(resTab)] <= power) stop("Optimal N above range")
}
NRange <- c(12, 25) # sensible range of Ns (min, max)
NRange <- c(12, 25) # sensible range of Ns (min, max)
replications <- 100 # initial replications per N (-> speed v accuracy). Last round uses 10fold reps.
power <- 0.80 # to accomodate CI width planning
for (i in 1:100) { # outer loop: steering the Ns put into power analyses below
if (i == 1) { # for first sequence on Ns
last <- FALSE
Ntest <- seq(NRange[1], NRange[2], round((NRange[2] - NRange[1]) / 5))
res <- data.frame(matrix(0,
replications*length(Ntest),
2))
colnames(res) <- c("N", "p")
} else { # for further sequences of Ns
optim <- which((resTab$power > power) == TRUE)[1]
NRange <- c(Ntest[optim - 1], Ntest[optim + 1])
if (last) {
print(paste0("Optimal N: ", Ntest[optim]))
break}
if (Ntest[optim] - Ntest[optim - 1] <= 5) {
Ntest <- seq(NRange[1]-1, NRange[2], 1)
last <- TRUE
replications <- 10*replications
} else {
Ntest <- seq(NRange[1], NRange[2], round((NRange[2] - NRange[1]) / 5))
}
res <- data.frame(matrix(0,
replications*length(Ntest),
2))
colnames(res) <- c("N", "p")
}
for (N in Ntest) { # inner loop: power analysis itself.
print(N)
for (rep in 1:replications) {
Dat <- simulate_lmm(n_subjects = N,
n_time = 35,
R2_marginal = 0.31)
mod <- suppressWarnings(lmer(y ~ 1 + time + (1 + time|id),
data = Dat))
p <- summary(mod)$coefficients[2, 5]
res[rep + replications*(which(Ntest %in% N) - 1), 1] <- N
res[rep + replications*(which(Ntest %in% N) - 1), 2] <- p
}
}
res$test <- res$p < .05
resTab <- aggregate(res$test, by = list(res$N), FUN = sum) # calculating achieved power per N
colnames(resTab) <- c("N", "power")
resTab$power <- resTab$power / replications
print(resTab)
if (resTab$power[1] >= power) stop("Optimal N below range")
if (resTab$power[nrow(resTab)] <= power) stop("Optimal N above range")
}
