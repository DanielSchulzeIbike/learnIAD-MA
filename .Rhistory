simulate_lmm <- function(
n_subjects = 200,
n_time = 5,
times = NULL,              # optional numeric vector of length n_time (same for all subjects)
R2_marginal = 0.30,        # target marginal R^2 (0 < R2 < 1)
beta0 = 0,                 # fixed intercept (doesn't affect R2)
beta1_base = 1,            # base fixed slope before scaling (must be != 0)
sd_intercept = 1.0,        # sqrt(tau00)
sd_slope = 0.5,            # sqrt(tau11)
rho = 0.0,                 # corr(random intercept, random slope) in [-1, 1]
sigma = 1.0,               # residual SD
seed = NULL,
return_details = TRUE
){
if (!is.null(seed)) set.seed(seed)
if (!(R2_marginal > 0 && R2_marginal < 1)) stop("R2_marginal must be in (0,1).")
if (beta1_base == 0) stop("beta1_base must be nonzero so it can be scaled to hit the target R2.")
if (!(rho >= -1 && rho <= 1)) stop("rho must be between -1 and 1.")
if (is.null(times)) times <- seq_len(n_time) - 1  # 0,1,2,... default equally spaced
# Construct design (balanced) -------------------------------------------------
id <- rep(seq_len(n_subjects), each = n_time)
t  <- rep(times, times = n_subjects)
t_center <- t - mean(t)               # grand-mean centering for clean variance expressions
# Random-effects covariance matrix -------------------------------------------
D <- matrix(c(sd_intercept^2, rho*sd_intercept*sd_slope,
rho*sd_intercept*sd_slope, sd_slope^2), nrow = 2, byrow = TRUE)
# Variance components needed for R2_m ----------------------------------------
var_t <- var(t_center)
V_r   <- sd_intercept^2 + sd_slope^2 * var_t                      # Var(Z b) with centered time
# Base fixed-effect variance (intercept adds no variance across obs)
V_f_base <- (beta1_base^2) * var_t
if (V_f_base == 0) stop("Design has zero variance in time after centering; cannot set R2.")
# Solve for scaling factor on the fixed slope to hit target R2_m -------------
s2 <- (R2_marginal * (V_r + sigma^2)) / ((1 - R2_marginal) * V_f_base)
if (s2 <= 0) stop("Infeasible combination of parameters produced non-positive slope scale.")
s  <- sqrt(s2)
beta1 <- s * beta1_base  # scaled fixed slope
# Simulate random effects and outcomes ---------------------------------------
# Draw subject-level (b0_i, b1_i)
# Use mvtnorm::rmvnorm if preferred; MASS::mvrnorm is widely available
if (!requireNamespace("MASS", quietly = TRUE)) stop("Please install 'MASS'.")
b <- MASS::mvrnorm(n_subjects, mu = c(0, 0), Sigma = D)
b0 <- rep(b[,1], each = n_time)
b1 <- rep(b[,2], each = n_time)
# Linear predictor and response
mu_fixed  <- beta0 + beta1 * t_center
mu_random <- b0 + b1 * t_center
y <- mu_fixed + mu_random + rnorm(length(id), mean = 0, sd = sigma)
# Diagnostics / achieved R2_m -------------------------------------------------
# Theoretical (design-based) components:
V_f <- beta1^2 * var_t
V_theory_total <- V_f + V_r + sigma^2
R2_theory <- V_f / V_theory_total
# Empirical (realized sample) components:
V_f_emp <- var(mu_fixed)
# For the random part, compute per-observation variance of Zb given the sampled b's:
V_r_emp <- var(mu_random)
V_y_emp <- var(y)
R2_emp  <- V_f_emp / (V_f_emp + V_r_emp + sigma^2)
out <- data.frame(
id = factor(id),
time = as.numeric(t),
time_c = as.numeric(t_center),
y = as.numeric(y),
mu_fixed = as.numeric(mu_fixed),
mu_random = as.numeric(mu_random)
)
if (!return_details) return(out)
details <- list(
inputs = list(
n_subjects = n_subjects, n_time = n_time, times = times,
R2_marginal_target = R2_marginal, beta0 = beta0, beta1_base = beta1_base,
sd_intercept = sd_intercept, sd_slope = sd_slope, rho = rho, sigma = sigma
),
derived = list(
var_time = var_t, V_random = V_r, V_fixed_base = V_f_base,
slope_scale = s, beta1_scaled = beta1
),
achieved = list(
R2_theory = R2_theory,
components_theory = c(V_fixed = V_f, V_random = V_r, V_resid = sigma^2,
V_total = V_theory_total),
R2_empirical = R2_emp,
components_empirical = c(V_fixed = V_f_emp, V_random = V_r_emp,
V_resid = sigma^2, V_total = V_y_emp)
)
)
attr(out, "details") <- details
out
}
